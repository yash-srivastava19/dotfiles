# Files listed here are NOT applied to $HOME on this machine.
# This file is itself a template, so it can branch on OS and distro.

{{ if eq .chezmoi.os "linux" -}}
{{   if ne .chezmoi.osRelease.id "omarchy" -}}
# Linux, but not Omarchy: the Hyprland config assumes Omarchy's own lua
# modules ($OMARCHY_PATH/default/hypr/bootstrap.lua) and is useless without
# them, so it is skipped entirely rather than half-applied.
.config/hypr
.config/omarchy
{{   end -}}
{{ else -}}
# Not Linux at all — no Wayland, no Hyprland, no Omarchy.
# Checked in the else branch on purpose: .chezmoi.osRelease does not exist on
# macOS, so referencing it outside a linux guard would error.
.config/hypr
.config/omarchy
{{ end -}}
